# Service
HOST=127.0.0.1
PORT=8080
SERVICE_VERSION=0.1.0-dev
GIT_COMMIT=dev

# Caller auth
# Leave empty only for local bring-up before runtime admission.
CALLER_ALLOWED_IDS=openclaw-telegram-enhanced
CALLER_AUTH_SHARED_SECRET=
# Delivery ART v2 mutations require a distinct caller-bound secret for every
# admitted operator identity. Shared-secret callers remain v1 compatibility
# callers and cannot mutate v2 custody artifacts.
CALLER_AUTH_SECRETS_JSON={}

# Delivery ART custody and readiness
# OOS uses one method-scoped WGCF identity for registry and readiness methods.
# It never receives the backing object-store credential.
WGCF_DELIVERY_ART_BASE_URL=
WGCF_DELIVERY_ART_CALLER_ID=operator-orchestration-service
WGCF_DELIVERY_ART_CALLER_SECRET=
# Both controls are required before any v2 artifact write is admitted.
OOS_DELIVERY_ART_MUTATION_ENABLED=false
OOS_DELIVERY_ART_WRITER_TOPOLOGY=

# OpenProject
OPENPROJECT_BASE_URL=http://127.0.0.1:32083
OPENPROJECT_HOST_HEADER=127.0.0.1:32083
OPENPROJECT_PROJECT_IDENTIFIER=workspace-proposals
OPENPROJECT_DELIVERY_PROJECT_IDENTIFIER=workspace-delivery-art
OPENPROJECT_API_TOKEN=

# These ids are instance-specific and must match the canonical backlog and
# delivery project models.
OPENPROJECT_IDEA_TYPE_ID=41
OPENPROJECT_DELIVERY_TOP_LEVEL_TYPE_ID=
OPENPROJECT_CAPTURED_STATUS_ID=81
OPENPROJECT_TRIAGED_STATUS_ID=82
OPENPROJECT_PARKED_STATUS_ID=83
OPENPROJECT_ACCEPTED_STATUS_ID=85
OPENPROJECT_REJECTED_STATUS_ID=80
OPENPROJECT_DELIVERY_NEW_STATUS_ID=
OPENPROJECT_CUSTOM_FIELD_SUSPECTED_OWNER_ID=3
OPENPROJECT_CUSTOM_FIELD_AFFECTED_SCOPE_ID=4
OPENPROJECT_CUSTOM_FIELD_TRUST_BOUNDARY_AREAS_ID=5
OPENPROJECT_CUSTOM_FIELD_TRIAGE_CONFIDENCE_ID=8
OPENPROJECT_CUSTOM_FIELD_AI_ASSIST_LANE_ID=9
OPENPROJECT_CUSTOM_FIELD_SOURCE_SURFACE_ID=1
OPENPROJECT_CUSTOM_FIELD_SOURCE_REFERENCE_ID=2
OPENPROJECT_CUSTOM_FIELD_DELIVERY_REF_ID=
OPENPROJECT_DELIVERY_CUSTOM_FIELD_ORIGIN_IDEA_REF_ID=
OPENPROJECT_DELIVERY_CUSTOM_FIELD_PM2_PHASE_ID=
OPENPROJECT_DELIVERY_CUSTOM_FIELD_TARGET_PI_ID=

# Workspace-derived canonical evaluation tokens.
WORKSPACE_OWNER_TOKENS_JSON=["repo:workspace-governance","repo:platform-engineering","product:openclaw","component:operator-orchestration-service"]
WORKSPACE_SCOPE_TOKENS_JSON=["repo:workspace-governance","repo:platform-engineering","product:openclaw","component:operator-orchestration-service"]
