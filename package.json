{
  "name": "operator-orchestration-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared operator workflow broker for capture-first idea intake into OpenProject.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "api:contract": "node scripts/show_api_contract.mjs",
    "api:probe": "node scripts/probe_api_contract.mjs",
    "art:assignees": "node scripts/show_delivery_art_assignables.mjs",
    "test": "node --test",
    "validate:completion-evidence": "node scripts/validate_completion_evidence.mjs",
    "validate:api-docs": "node scripts/validate_api_docs.mjs",
    "validate:governance-docs": "python3 scripts/validate_governance_docs.py --repo-root .",
    "validate:change-record-requirement": "python3 scripts/validate_change_record_requirement.py --repo-root . --against-ref origin/main"
  }
}
