{
  "name": "operator-orchestration-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared operator workflow broker and bounded durable orchestration service.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "api:contract": "node scripts/show_api_contract.mjs",
    "api:probe": "node scripts/probe_api_contract.mjs",
    "art": "node scripts/art_cli.mjs",
    "art:assignees": "node scripts/show_delivery_art_assignables.mjs",
    "orchestration:worker": "node src/orchestration-worker.js",
    "refinement:worker": "node src/refinement-worker.js",
    "sync:orchestration-openapi-schemas": "node scripts/sync_orchestration_openapi_schemas.mjs",
    "sync:proposal-openapi-schemas": "node scripts/sync_proposal_openapi_schemas.mjs",
    "sync:delivery-ingress-openapi-schemas": "node scripts/sync_delivery_ingress_openapi_schemas.mjs",
    "sync:delivery-art-contracts": "node scripts/sync_delivery_art_contracts.mjs",
    "sync:delivery-work-session-openapi": "node scripts/sync_delivery_work_session_openapi.mjs",
    "sync:work-design-openapi-schemas": "node scripts/sync_work_design_openapi_schemas.mjs",
    "sync:refinement-openapi-schemas": "node scripts/sync_refinement_openapi_schemas.mjs",
    "sync:catalog-openapi-schemas": "node scripts/sync_catalog_openapi_schemas.mjs",
    "sync:delivery-change-openapi-schemas": "node scripts/sync_delivery_change_openapi_schemas.mjs",
    "sync:delivery-closeout-openapi-schemas": "node scripts/sync_delivery_closeout_openapi_schemas.mjs",
    "sync:repository-custody-openapi-schemas": "node scripts/sync_repository_custody_openapi_schemas.mjs",
    "sync:repository-lifecycle-openapi-schemas": "node scripts/sync_repository_lifecycle_openapi_schemas.mjs",
    "test": "node --test",
    "test:workspace-intake-source": "node scripts/test_workspace_intake_source.mjs",
    "sync:workspace-intake-openapi": "node scripts/sync_workspace_intake_openapi.mjs",
    "validate:workspace-intake-openapi": "node scripts/sync_workspace_intake_openapi.mjs --check",
    "validate:orchestration-bundle": "node scripts/validate_orchestration_bundle.mjs",
    "validate:refinement-bundle": "node scripts/validate_refinement_bundle.mjs",
    "validate:completion-evidence": "node scripts/validate_completion_evidence.mjs",
    "validate:orchestration-openapi-schemas": "node scripts/sync_orchestration_openapi_schemas.mjs --check",
    "validate:proposal-openapi-schemas": "node scripts/sync_proposal_openapi_schemas.mjs --check",
    "validate:delivery-ingress-openapi-schemas": "node scripts/sync_delivery_ingress_openapi_schemas.mjs --check",
    "validate:delivery-art-contracts": "node scripts/sync_delivery_art_contracts.mjs --check",
    "validate:delivery-work-session-openapi": "node scripts/sync_delivery_work_session_openapi.mjs --check",
    "validate:work-design-openapi-schemas": "node scripts/sync_work_design_openapi_schemas.mjs --check",
    "validate:refinement-openapi-schemas": "node scripts/sync_refinement_openapi_schemas.mjs --check",
    "validate:catalog-openapi-schemas": "node scripts/sync_catalog_openapi_schemas.mjs --check",
    "validate:delivery-change-openapi-schemas": "node scripts/sync_delivery_change_openapi_schemas.mjs --check",
    "validate:delivery-closeout-openapi-schemas": "node scripts/sync_delivery_closeout_openapi_schemas.mjs --check",
    "validate:repository-custody-openapi-schemas": "node scripts/sync_repository_custody_openapi_schemas.mjs --check",
    "validate:repository-lifecycle-openapi-schemas": "node scripts/sync_repository_lifecycle_openapi_schemas.mjs --check",
    "validate:work-item-create": "node scripts/validate_work_item_create.mjs",
    "validate:api-docs": "node scripts/sync_delivery_work_session_openapi.mjs --check && node scripts/sync_delivery_change_openapi_schemas.mjs --check && node scripts/sync_delivery_closeout_openapi_schemas.mjs --check && node scripts/sync_repository_custody_openapi_schemas.mjs --check && node scripts/sync_repository_lifecycle_openapi_schemas.mjs --check && node scripts/validate_api_docs.mjs",
    "validate:governance-docs": "python3 scripts/validate_governance_docs.py --repo-root .",
    "validate:change-record-requirement": "python3 scripts/validate_change_record_requirement.py --repo-root . --against-ref origin/main",
    "validate:openproject-mutation-contracts": "python3 scripts/validate_openproject_mutation_contracts.py --repo-root . --against-ref origin/main"
  },
  "dependencies": {
    "@temporalio/client": "1.21.1",
    "@temporalio/worker": "1.21.1",
    "@temporalio/workflow": "1.21.1",
    "ajv": "^8.20.0",
    "ajv-formats": "3.0.1"
  }
}
