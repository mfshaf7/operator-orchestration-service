{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operator-orchestration-service.local/contracts/project-runtime/source-snapshot.schema.json",
  "title": "Private saved-project source snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "source",
    "setup",
    "command_id",
    "total_bytes",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "setup": {
      "$ref": "#/$defs/setup"
    },
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "manifest_digest"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "pattern": "^project-source:[a-f0-9]{64}$"
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installation_id",
        "project_custody_ref",
        "repository_id",
        "app_root",
        "dependency_paths",
        "environment_ref"
      ],
      "properties": {
        "installation_id": {
          "type": "string",
          "minLength": 1
        },
        "project_custody_ref": {
          "type": "string",
          "minLength": 1
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "app_root": {
          "type": "string",
          "minLength": 1
        },
        "dependency_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "environment_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "base_commit",
            "session_id"
          ],
          "properties": {
            "kind": {
              "const": "committed"
            },
            "base_commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "session_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "base_commit",
            "session_id",
            "revision",
            "change_set_digest"
          ],
          "properties": {
            "kind": {
              "const": "saved-draft"
            },
            "base_commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "session_id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "change_set_digest": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      ]
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe_id",
        "configuration_revision"
      ],
      "properties": {
        "recipe_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "type",
        "mode",
        "size",
        "blob_digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "file"
        },
        "mode": {
          "enum": [
            "100644",
            "100755"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "blob_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
