{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operator-orchestration-service.local/contracts/delivery-art-work-session/lifecycle-context-request.schema.json",
  "title": "Delivery ART Lifecycle Context Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "execution_id",
    "operation",
    "mode",
    "budget_tokens",
    "fallback_reason"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "$ref": "#/$defs/stableId" },
    "execution_id": { "$ref": "#/$defs/stableId" },
    "operation": {
      "enum": [
        "close",
        "continue",
        "history",
        "inspect",
        "merge",
        "reconstruct",
        "recover",
        "start"
      ]
    },
    "mode": { "enum": ["packet", "raw-fallback"] },
    "budget_tokens": { "type": "integer", "minimum": 1, "maximum": 8000 },
    "fallback_reason": {
      "oneOf": [
        { "type": "string", "minLength": 20, "maxLength": 1000 },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "raw-fallback" } } },
      "then": { "properties": { "fallback_reason": { "type": "string" } } },
      "else": { "properties": { "fallback_reason": { "type": "null" } } }
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    }
  }
}
