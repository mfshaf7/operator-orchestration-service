{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operator-orchestration-service.local/contracts/delivery-art-work-session/evidence-profile.schema.json",
  "title": "Delivery ART owner evidence profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "owner_repo", "commands"],
  "properties": {
    "schema_version": { "const": 1 },
    "profile_id": { "$ref": "#/$defs/identifier" },
    "owner_repo": { "$ref": "#/$defs/identifier" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/command" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "executable",
        "args",
        "fidelity",
        "conformance_binding",
        "timeout_seconds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "enum": ["tests", "validations", "runtime_and_live", "security_and_trust"]
        },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "executable": {
          "enum": ["git", "node", "npm", "python3"]
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "fidelity": {
          "enum": [
            "pure-unit",
            "filesystem",
            "real-git",
            "process-crash",
            "sandbox-runtime",
            "live-backend"
          ]
        },
        "conformance_binding": {
          "enum": ["matching-fidelity", "none"]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        }
      }
    }
  }
}
