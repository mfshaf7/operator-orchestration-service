{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operator-orchestration-service.local/contracts/delivery-art-work-session/evidence-profile.schema.json",
  "title": "Delivery ART owner evidence profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "owner_repo",
    "commands"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "$ref": "#/$defs/identifier"
    },
    "owner_repo": {
      "$ref": "#/$defs/identifier"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "application_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "manual_checks"
      ],
      "properties": {
        "mode": {
          "enum": [
            "unconfigured",
            "manual",
            "automated",
            "mixed"
          ]
        },
        "manual_checks": {
          "type": "array",
          "maxItems": 48,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "action",
              "expected_result"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "expected_result": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "executable",
        "args",
        "fidelity",
        "conformance_binding",
        "timeout_seconds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "tests",
            "validations",
            "runtime_and_live",
            "security_and_trust"
          ]
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "executable": {
          "enum": [
            "git",
            "node",
            "npm",
            "python3"
          ]
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fidelity": {
          "enum": [
            "pure-unit",
            "filesystem",
            "real-git",
            "process-crash",
            "sandbox-runtime",
            "live-backend"
          ]
        },
        "conformance_binding": {
          "enum": [
            "matching-fidelity",
            "none"
          ]
        },
        "conformance_case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        },
        "scope": {
          "enum": [
            "source-controls",
            "application"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "source-controls"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "validations"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "application_verification"
        ]
      },
      "then": {
        "properties": {
          "commands": {
            "contains": {
              "type": "object",
              "required": [
                "scope",
                "kind"
              ],
              "properties": {
                "scope": {
                  "const": "source-controls"
                },
                "kind": {
                  "const": "validations"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "application_verification"
        ],
        "properties": {
          "application_verification": {
            "properties": {
              "mode": {
                "const": "unconfigured"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "application_verification": {
            "properties": {
              "manual_checks": {
                "maxItems": 0
              }
            }
          },
          "commands": {
            "items": {
              "required": [
                "scope"
              ],
              "properties": {
                "scope": {
                  "const": "source-controls"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "application_verification"
        ],
        "properties": {
          "application_verification": {
            "properties": {
              "mode": {
                "const": "manual"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "application_verification": {
            "properties": {
              "manual_checks": {
                "minItems": 1
              }
            }
          },
          "commands": {
            "not": {
              "contains": {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "tests"
                  },
                  "scope": {
                    "not": {
                      "const": "source-controls"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "application_verification"
        ],
        "properties": {
          "application_verification": {
            "properties": {
              "mode": {
                "const": "automated"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "application_verification": {
            "properties": {
              "manual_checks": {
                "maxItems": 0
              }
            }
          },
          "commands": {
            "contains": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "tests"
                },
                "scope": {
                  "not": {
                    "const": "source-controls"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "application_verification"
        ],
        "properties": {
          "application_verification": {
            "properties": {
              "mode": {
                "const": "mixed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "application_verification": {
            "properties": {
              "manual_checks": {
                "minItems": 1
              }
            }
          },
          "commands": {
            "contains": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "tests"
                },
                "scope": {
                  "not": {
                    "const": "source-controls"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
