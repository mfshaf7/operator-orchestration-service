{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operator-orchestration-service.local/contracts/delivery-art-work-session/lifecycle-context-ledger.schema.json",
  "title": "Delivery ART Lifecycle Context Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "session_id",
    "bindings",
    "measurements",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_type": { "const": "delivery_art_lifecycle_context_ledger" },
    "session_id": {
      "type": "string",
      "pattern": "^work-session:delivery-[1-9][0-9]*:[a-z0-9][a-z0-9._:-]*$"
    },
    "bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/binding" }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_count", "raw_fallback_count", "denied_count"],
      "properties": {
        "packet_count": { "type": "integer", "minimum": 0 },
        "raw_fallback_count": { "type": "integer", "minimum": 0 },
        "denied_count": { "type": "integer", "minimum": 0 }
      }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "execution_id",
        "operation",
        "lifecycle_state",
        "mode",
        "captured_at",
        "sources_digest",
        "source_summary",
        "packet_ref",
        "redaction_receipt_ref",
        "projection_receipt_ref",
        "request_digest",
        "artifact_digest",
        "content_digest",
        "fallback_reason"
      ],
      "properties": {
        "request_id": { "$ref": "#/$defs/stableId" },
        "execution_id": { "$ref": "#/$defs/stableId" },
        "operation": {
          "enum": [
            "close",
            "continue",
            "history",
            "inspect",
            "merge",
            "reconstruct",
            "recover",
            "start"
          ]
        },
        "lifecycle_state": { "$ref": "#/$defs/stableId" },
        "mode": { "enum": ["packet", "raw-fallback", "denied"] },
        "captured_at": { "type": "string", "format": "date-time" },
        "sources_digest": { "$ref": "#/$defs/sha256" },
        "source_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "available", "unavailable", "classes"],
          "properties": {
            "total": { "type": "integer", "minimum": 1, "maximum": 16 },
            "available": { "type": "integer", "minimum": 0, "maximum": 16 },
            "unavailable": { "type": "integer", "minimum": 0, "maximum": 16 },
            "classes": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["art", "repository", "runtime", "validation"] }
            }
          }
        },
        "packet_ref": { "type": ["string", "null"] },
        "redaction_receipt_ref": { "type": ["string", "null"] },
        "projection_receipt_ref": { "type": ["string", "null"] },
        "request_digest": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "artifact_digest": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "content_digest": { "$ref": "#/$defs/sha256" },
        "fallback_reason": { "type": ["string", "null"], "maxLength": 1000 }
      }
    }
  }
}
