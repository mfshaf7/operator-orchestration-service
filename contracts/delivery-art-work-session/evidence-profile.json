{
  "schema_version": 1,
  "profile_id": "oos-delivery-art-evidence-v1",
  "owner_repo": "operator-orchestration-service",
  "commands": [
    {
      "id": "locked-dependency-install",
      "kind": "validations",
      "name": "Locked dependency installation",
      "executable": "npm",
      "args": [
        "ci",
        "--ignore-scripts"
      ],
      "fidelity": "sandbox-runtime",
      "conformance_binding": "none",
      "timeout_seconds": 300
    },
    {
      "id": "owner-repository-tests",
      "kind": "tests",
      "name": "Owner repository test suite",
      "executable": "npm",
      "args": ["test"],
      "fidelity": "real-git",
      "conformance_binding": "matching-fidelity",
      "timeout_seconds": 1200
    },
    {
      "id": "owner-repository-tests-unbound",
      "kind": "tests",
      "name": "Owner repository test suite for non-architecture source work",
      "executable": "npm",
      "args": ["test"],
      "fidelity": "real-git",
      "conformance_binding": "none",
      "timeout_seconds": 1200
    },
    {
      "id": "owner-repository-sandbox-runtime-tests",
      "kind": "tests",
      "name": "Owner repository test suite in the bounded source-executor runtime",
      "executable": "npm",
      "args": [
        "test"
      ],
      "fidelity": "sandbox-runtime",
      "conformance_binding": "matching-fidelity",
      "timeout_seconds": 1200
    },
    {
      "id": "project-runtime-restart-operating-verification",
      "kind": "runtime_and_live",
      "name": "Recover the original project run after a broker restart",
      "executable": "node",
      "args": ["scripts/verify_project_runtime_rehearsal.mjs", "recovery"],
      "fidelity": "sandbox-runtime",
      "conformance_binding": "matching-fidelity",
      "conformance_case_ids": ["cases-b17cb044-3324-4788-8202-9e2dfc18947a"],
      "timeout_seconds": 30
    },
    {
      "id": "project-runtime-rejection-operating-verification",
      "kind": "runtime_and_live",
      "name": "Reject invalid source and replays while preserving results",
      "executable": "node",
      "args": ["scripts/verify_project_runtime_rehearsal.mjs", "rejected_inputs"],
      "fidelity": "sandbox-runtime",
      "conformance_binding": "matching-fidelity",
      "conformance_case_ids": ["cases-bc81236b-2c49-4aff-9a1f-d211ee142c79"],
      "timeout_seconds": 30
    },
    {
      "id": "api-contract-validation",
      "kind": "validations",
      "name": "Generated API contract validation",
      "executable": "npm",
      "args": ["run", "validate:api-docs"],
      "fidelity": "filesystem",
      "conformance_binding": "matching-fidelity",
      "timeout_seconds": 300
    },
    {
      "id": "governance-document-validation",
      "kind": "validations",
      "name": "Governance document validation",
      "executable": "npm",
      "args": ["run", "validate:governance-docs"],
      "fidelity": "filesystem",
      "conformance_binding": "none",
      "timeout_seconds": 300
    },
    {
      "id": "source-diff-validation",
      "kind": "validations",
      "name": "Source diff whitespace validation",
      "executable": "git",
      "args": ["diff", "--check", "{{base_commit}}...{{head_commit}}"],
      "fidelity": "real-git",
      "conformance_binding": "none",
      "timeout_seconds": 60
    }
  ]
}
