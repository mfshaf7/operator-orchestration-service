{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operator-orchestration-service.local/contracts/delivery-art-work-session/recovery-receipt.schema.json",
  "title": "Delivery ART Work Session Recovery Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "receipt_id",
    "delivery_id",
    "work_item_id",
    "session_id",
    "session_revision",
    "session_digest",
    "landing_unit_id",
    "caller_id",
    "operator_id",
    "reason",
    "missing_premerge_review_packet",
    "missing_readiness_receipt",
    "recorded_at",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_type": { "const": "delivery_art_work_session_recovery_receipt" },
    "receipt_id": { "type": "string", "pattern": "^work-session-recovery:work-session:delivery-[1-9][0-9]*:[a-z0-9][a-z0-9._:-]*$" },
    "delivery_id": { "type": "string", "pattern": "^delivery-[1-9][0-9]*$" },
    "work_item_id": { "type": "string", "pattern": "^work-item-[1-9][0-9]*$" },
    "session_id": { "type": "string", "pattern": "^work-session:delivery-[1-9][0-9]*:[a-z0-9][a-z0-9._:-]*$" },
    "session_revision": { "type": "string", "format": "date-time" },
    "session_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "landing_unit_id": { "type": "string", "minLength": 1 },
    "caller_id": { "type": "string", "minLength": 1 },
    "operator_id": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 20 },
    "mode": { "const": "archive-unmerged" },
    "pull_request": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "head_commit", "merge_commit"],
          "properties": {
            "url": { "type": "string", "format": "uri", "pattern": "^https://" },
            "head_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "merge_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_branch_head", "worktree_head"],
      "properties": {
        "local_branch_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "worktree_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "source_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed_files", "local_branch_head", "pull_request_state", "remote_branch_head", "worktree_head", "worktree_present"],
      "properties": {
        "changed_files": { "type": "array", "maxItems": 0 },
        "local_branch_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "pull_request_state": { "const": "missing" },
        "remote_branch_head": { "type": "null" },
        "worktree_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "worktree_present": { "const": true }
      }
    },
    "missing_premerge_review_packet": { "const": true },
    "missing_readiness_receipt": { "const": true },
    "recorded_at": { "type": "string", "format": "date-time" },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest"],
      "properties": {
        "content_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  },
  "oneOf": [
    {
      "required": ["pull_request"],
      "not": { "anyOf": [{ "required": ["mode"] }, { "required": ["source"] }, { "required": ["source_proof"] }] },
      "properties": { "pull_request": { "type": "object" } }
    },
    {
      "required": ["mode", "pull_request", "source", "source_proof"],
      "properties": { "pull_request": { "type": "null" } }
    }
  ]
}
