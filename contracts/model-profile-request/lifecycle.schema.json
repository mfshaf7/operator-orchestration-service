{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operator-orchestration-service.local/contracts/model-profile-request/lifecycle.schema.json",
  "$defs": {
    "selection": {
      "type": "object",
      "required": [
        "request_id",
        "profile_id",
        "intent",
        "environment",
        "changes"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^model-profile-request:[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "intent": {
          "enum": [
            "create",
            "amend",
            "activate",
            "suspend",
            "retire",
            "exception"
          ]
        },
        "environment": {
          "const": "dev-integration"
        },
        "changes": {
          "type": "object",
          "required": [],
          "properties": {
            "allowed_data_scope": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "runtime_limits": {
              "type": "object",
              "required": [],
              "properties": {
                "max_request_bytes": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 1000000
                },
                "max_output_tokens": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32768
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 300
                },
                "retry_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "max_concurrency": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8
                }
              },
              "additionalProperties": false
            },
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "submission": {
      "type": "object",
      "required": [
        "request_id",
        "profile_id",
        "intent",
        "environment",
        "changes",
        "preparation_digest",
        "display_name",
        "intended_purpose",
        "input_data_classification",
        "operator_justification"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^model-profile-request:[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "intent": {
          "enum": [
            "create",
            "amend",
            "activate",
            "suspend",
            "retire",
            "exception"
          ]
        },
        "environment": {
          "const": "dev-integration"
        },
        "changes": {
          "type": "object",
          "required": [],
          "properties": {
            "allowed_data_scope": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "runtime_limits": {
              "type": "object",
              "required": [],
              "properties": {
                "max_request_bytes": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 1000000
                },
                "max_output_tokens": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32768
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 300
                },
                "retry_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "max_concurrency": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8
                }
              },
              "additionalProperties": false
            },
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "additionalProperties": false
        },
        "preparation_digest": {
          "$ref": "request.schema.json#/$defs/digest"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "intended_purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "input_data_classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "operator_justification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "required": [
        "action",
        "expected_operation_digest"
      ],
      "properties": {
        "action": {
          "enum": [
            "implement",
            "continue",
            "approve-merge",
            "reconcile",
            "restore",
            "decline-source"
          ]
        },
        "expected_operation_digest": {
          "oneOf": [
            {
              "$ref": "request.schema.json#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "securityAcceptance": {
      "type": "object",
      "required": [
        "command_id",
        "expected_revision",
        "reason"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "pattern": "^model-profile-security:[A-Za-z0-9._:-]{1,180}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "additionalProperties": false
    },
    "reviewDecisionCommand": {
      "type": "object",
      "required": [
        "schema_version",
        "command_id",
        "request_id",
        "expected_revision",
        "action",
        "operator_id",
        "issued_at",
        "reason",
        "decision_ref",
        "requirements",
        "revised_profile_intent",
        "idempotency_key"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "command_id": {
          "$ref": "request.schema.json#/$defs/identifier"
        },
        "request_id": {
          "$ref": "request.schema.json#/$defs/requestId"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "enum": [
            "approve",
            "reject"
          ]
        },
        "operator_id": {
          "$ref": "request.schema.json#/$defs/identifier"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "decision_ref": {
          "type": "null"
        },
        "requirements": {
          "type": "array",
          "maxItems": 0
        },
        "revised_profile_intent": {
          "type": "null"
        },
        "idempotency_key": {
          "$ref": "request.schema.json#/$defs/identifier"
        }
      },
      "additionalProperties": false
    },
    "revision": {
      "type": "object",
      "required": [
        "request_id",
        "profile_id",
        "intent",
        "environment",
        "changes",
        "preparation_digest",
        "display_name",
        "intended_purpose",
        "input_data_classification",
        "operator_justification",
        "expected_revision",
        "command_id"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^model-profile-request:[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "intent": {
          "enum": [
            "create",
            "amend",
            "activate",
            "suspend",
            "retire",
            "exception"
          ]
        },
        "environment": {
          "const": "dev-integration"
        },
        "changes": {
          "type": "object",
          "required": [],
          "properties": {
            "allowed_data_scope": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "runtime_limits": {
              "type": "object",
              "required": [],
              "properties": {
                "max_request_bytes": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 1000000
                },
                "max_output_tokens": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32768
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 300
                },
                "retry_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "max_concurrency": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8
                }
              },
              "additionalProperties": false
            },
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "additionalProperties": false
        },
        "preparation_digest": {
          "$ref": "request.schema.json#/$defs/digest"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "intended_purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "input_data_classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "operator_justification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "command_id": {
          "type": "string",
          "pattern": "^model-profile-command:[A-Za-z0-9][A-Za-z0-9._:-]{0,150}$"
        }
      },
      "additionalProperties": false
    }
  }
}
