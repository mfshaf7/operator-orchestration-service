{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operator-orchestration-service.local/contracts/model-profile-request/request.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "intent",
    "requested_at",
    "operator_id",
    "profile_intent",
    "delivery_ref",
    "correlation_id",
    "causation_id",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "$ref": "#/$defs/requestId" },
    "intent": { "$ref": "#/$defs/intent" },
    "requested_at": { "type": "string", "format": "date-time" },
    "operator_id": { "$ref": "#/$defs/identifier" },
    "profile_intent": { "$ref": "#/$defs/profileIntent" },
    "delivery_ref": {
      "oneOf": [
        { "type": "string", "pattern": "^openproject://work_packages/[1-9][0-9]*$" },
        { "type": "null" }
      ]
    },
    "correlation_id": { "$ref": "#/$defs/identifier" },
    "causation_id": {
      "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
    },
    "idempotency_key": { "$ref": "#/$defs/identifier" }
  },
  "allOf": [
    {
      "if": { "properties": { "intent": { "const": "create" } } },
      "then": {
        "properties": {
          "profile_intent": {
            "properties": {
              "profile_id": { "type": "null" },
              "source": { "type": "null" }
            }
          }
        }
      },
      "else": {
        "properties": {
          "profile_intent": {
            "properties": {
              "profile_id": { "$ref": "#/$defs/profileId" },
              "source": { "$ref": "#/$defs/sourceBinding" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^model-profile-request:[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "profileId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "intent": {
      "enum": ["create", "amend", "activate", "suspend", "retire", "exception"]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifactRef": {
      "type": "object",
      "required": ["uri", "digest"],
      "properties": {
        "uri": { "type": "string", "format": "uri" },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "sourceBinding": {
      "type": "object",
      "required": ["registry_ref", "source_version"],
      "properties": {
        "registry_ref": { "$ref": "#/$defs/artifactRef" },
        "source_version": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": false
    },
    "registeredCaller": {
      "type": "object",
      "required": ["caller_id", "owner_repo"],
      "properties": {
        "caller_id": { "$ref": "#/$defs/identifier" },
        "owner_repo": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        }
      },
      "additionalProperties": false
    },
    "outputSchemaRef": {
      "type": "object",
      "required": ["repo", "path", "version"],
      "properties": {
        "repo": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "path": { "type": "string", "minLength": 1, "maxLength": 500 },
        "version": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": false
    },
    "profileIntent": {
      "type": "object",
      "required": [
        "profile_id",
        "source",
        "display_name",
        "intended_purpose",
        "requesting_owner",
        "registered_callers",
        "requested_environments",
        "input_data_classification",
        "admitted_context_ref",
        "required_output_schema_ref",
        "human_approval_required",
        "operational_expectations",
        "operator_justification"
      ],
      "properties": {
        "profile_id": {
          "oneOf": [{ "$ref": "#/$defs/profileId" }, { "type": "null" }]
        },
        "source": {
          "oneOf": [{ "$ref": "#/$defs/sourceBinding" }, { "type": "null" }]
        },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "intended_purpose": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "requesting_owner": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "registered_callers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/registeredCaller" }
        },
        "requested_environments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["dev-integration", "stage", "prod"] }
        },
        "input_data_classification": {
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "admitted_context_ref": { "$ref": "#/$defs/artifactRef" },
        "required_output_schema_ref": { "$ref": "#/$defs/outputSchemaRef" },
        "human_approval_required": { "const": true },
        "operational_expectations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "operator_justification": { "type": "string", "minLength": 1, "maxLength": 2000 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
