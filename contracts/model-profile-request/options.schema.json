{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operator-orchestration-service.local/contracts/model-profile-request/options.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "workflows"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "workflows": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "workflow_id",
          "setup_digest",
          "label",
          "purpose",
          "requesting_owner",
          "registered_callers",
          "environments",
          "output_schema_ref",
          "operational_expectations"
        ],
        "properties": {
          "workflow_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "setup_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "requesting_owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "registered_callers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "$ref": "request.schema.json#/$defs/registeredCaller"
            }
          },
          "environments": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "dev-integration",
                "stage",
                "prod"
              ]
            }
          },
          "output_schema_ref": {
            "$ref": "request.schema.json#/$defs/outputSchemaRef"
          },
          "operational_expectations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "guide": {
            "type": "object",
            "required": [
              "behavior",
              "input",
              "output",
              "instructions"
            ],
            "properties": {
              "behavior": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "input": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "output": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "instructions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "additionalProperties": false
          },
          "policy_defaults": {
            "type": "object",
            "required": [
              "allowed_data_scope",
              "runtime_limits"
            ],
            "properties": {
              "allowed_data_scope": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "runtime_limits": {
                "type": "object",
                "maxProperties": 10,
                "additionalProperties": false,
                "properties": {
                  "max_request_bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "max_output_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "timeout_seconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "retry_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "max_concurrency": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
