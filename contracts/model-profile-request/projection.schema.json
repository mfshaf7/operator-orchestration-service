{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operator-orchestration-service.local/contracts/model-profile-request/projection.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_id",
    "request_id",
    "revision",
    "request",
    "review_state",
    "fulfillment_state",
    "requirements",
    "decision_ref",
    "fulfillment",
    "latest_receipt",
    "history",
    "next_action",
    "profile_lifecycle_changed"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "workflow_id": { "const": "model-profile-request" },
    "request_id": { "$ref": "request.schema.json#/$defs/requestId" },
    "revision": { "type": "integer", "minimum": 1 },
    "request": { "$ref": "request.schema.json" },
    "review_state": {
      "enum": ["draft", "submitted", "under-review", "changes-required", "approved", "rejected", "withdrawn"]
    },
    "fulfillment_state": { "enum": ["not-started", "implementing", "applied", "failed"] },
    "requirements": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["requirement_id", "summary", "owner_repo", "next_action"],
        "properties": {
          "requirement_id": { "$ref": "request.schema.json#/$defs/identifier" },
          "summary": { "type": "string" },
          "owner_repo": { "type": "string" },
          "next_action": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "decision_ref": {
      "oneOf": [{ "$ref": "request.schema.json#/$defs/artifactRef" }, { "type": "null" }]
    },
    "fulfillment": {
      "oneOf": [{ "$ref": "fulfillment.schema.json" }, { "type": "null" }]
    },
    "latest_receipt": { "$ref": "receipt.schema.json" },
    "history": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "event_type",
          "occurred_at",
          "actor_id",
          "command_id",
          "review_state_before",
          "review_state_after",
          "fulfillment_state_before",
          "fulfillment_state_after",
          "summary",
          "receipt_ref"
        ],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "event_type": { "$ref": "request.schema.json#/$defs/identifier" },
          "occurred_at": { "type": "string", "format": "date-time" },
          "actor_id": { "$ref": "request.schema.json#/$defs/identifier" },
          "command_id": { "$ref": "request.schema.json#/$defs/identifier" },
          "review_state_before": {
            "oneOf": [
              { "enum": ["draft", "submitted", "under-review", "changes-required", "approved", "rejected", "withdrawn"] },
              { "type": "null" }
            ]
          },
          "review_state_after": { "enum": ["draft", "submitted", "under-review", "changes-required", "approved", "rejected", "withdrawn"] },
          "fulfillment_state_before": {
            "oneOf": [{ "enum": ["not-started", "implementing", "applied", "failed"] }, { "type": "null" }]
          },
          "fulfillment_state_after": { "enum": ["not-started", "implementing", "applied", "failed"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "receipt_ref": { "$ref": "request.schema.json#/$defs/artifactRef" }
        },
        "additionalProperties": false
      }
    },
    "next_action": {
      "enum": [
        "revise-or-submit",
        "start-review",
        "record-review-decision",
        "revise-and-resubmit",
        "begin-platform-fulfillment",
        "await-platform-fulfillment",
        "retry-or-correct-fulfillment",
        "refresh-authoritative-projections",
        "complete"
      ]
    },
    "profile_lifecycle_changed": { "const": false }
  },
  "additionalProperties": false
}
