{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace-governance.local/oos/orchestration/controlled-proof-control-request.schema.json",
  "title": "OOS Controlled Proof Scenario Control Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "commissioning_session_id",
    "scenario_execution_id",
    "control",
    "scenario_evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "commissioning_session_id": { "$ref": "#/$defs/identifier" },
    "scenario_execution_id": { "$ref": "#/$defs/identifier" },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "control_id",
        "action",
        "operator_id",
        "reason_ref",
        "idempotency_key"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "control_id": { "$ref": "#/$defs/identifier" },
        "action": { "enum": ["retry", "resume", "signal", "cancel", "defer"] },
        "operator_id": { "$ref": "#/$defs/identifier" },
        "reason_ref": { "$ref": "#/$defs/identifier" },
        "idempotency_key": { "$ref": "#/$defs/identifier" }
      }
    },
    "scenario_evidence": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/scenarioEvidence" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "control": {
            "properties": { "action": { "const": "signal" } }
          }
        }
      },
      "then": {
        "properties": {
          "scenario_evidence": { "$ref": "#/$defs/scenarioEvidence" }
        }
      },
      "else": {
        "properties": { "scenario_evidence": { "type": "null" } }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,255}$"
    },
    "uri": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512,
      "format": "uri"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "evidencePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "artifact_digest"],
      "properties": {
        "artifact_ref": { "$ref": "#/$defs/uri" },
        "artifact_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "scenarioEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_kind", "evidence_refs", "observed_at"],
      "properties": {
        "evidence_kind": {
          "enum": [
            "workflow-worker-restart-observed",
            "temporal-runtime-restart-observed",
            "deterministic-replay-verified",
            "duplicate-suppression-verified",
            "backup-restore-verified"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidencePointer" }
        },
        "observed_at": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
