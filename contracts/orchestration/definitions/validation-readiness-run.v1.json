{
  "schema_version": 1,
  "definition_id": "validation-readiness-run",
  "definition_version": 1,
  "title": "Validation readiness run",
  "purpose": "Prove the durable OOS-to-WGCF execution boundary with a bounded read-only validation and readiness evaluation.",
  "qualification": "durable-candidate",
  "lifecycle": "admission-review",
  "source_domain": "workspace-governance-control-fabric",
