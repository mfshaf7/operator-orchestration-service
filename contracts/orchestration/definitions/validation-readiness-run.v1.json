    "source_version_required": true
  },
  "approval_requirements": [
    "explicit-operator-approval"
  ],
  "source_version_refs": {
    "immutable_for_run": true,
    "source_projection_required": true
  },
  "idempotency_strategy": {
    "run_key": "definition_id:definition_version:idempotency_key",
    "activity_key": "run_key:execution_attempt",
    "duplicate_request_behavior": "return-existing-run-when-immutable-bindings-match-otherwise-conflict"
  },
  "lock_strategy": {
    "required": false,
    "reason": "The proof reads validation and readiness truth and performs no canonical mutation."
  },
  "execution_graph": [
    {
      "node_id": "wgcf-validation-readiness",
      "node_type": "activity",
      "label": "Evaluate validation and readiness",
      "owner": "workspace-governance-control-fabric",
      "adapter": "temporal-activity",
      "task_queue": "wgcf.validation-readiness.v1",
      "activity_name": "wgcf.validation-readiness.evaluate",
      "dependencies": [],
      "optional": false
    }
  ],
  "wait_and_signal_contract": {
    "wait_after_terminal_block": true,
    "accepted_controls": [
      "retry",
      "resume",
      "cancel",
      "defer"
    ],
    "signal_name": "oos.run.control.v1"
  },
  "retry_and_timeout_contract": {
    "activity_start_to_close": "5m",
    "activity_heartbeat_interval": "2s",
    "activity_heartbeat_timeout": null,
    "owner_execution_timeout": "4m",
    "owner_termination_grace": "5s",
    "automatic_retry_fence": "start-to-close-outlives-owner-bound",
    "automatic_max_attempts": 3,
    "automatic_initial_interval": "2s",
    "automatic_backoff_coefficient": 2,
    "automatic_max_interval": "30s",
    "manual_max_attempts": 3
  },
  "compensation_strategy": {
    "required": false,
    "reason": "The activity has no canonical side effect."
  },
  "cancellation_boundary": "Operator cancellation sends the admitted cancel control and interrupts the active activity or waiting run. Activation revocation denies new starts, signals cancel to every running definition execution, keeps workflow polling available until each run records a terminal projection and aggregate receipt, verifies the drain, and only then stops the worker; WGCF retains already-written local evidence.",
  "completion_condition": "WGCF returns a ready terminal decision and OOS records the aggregate receipt projection.",
  "expected_receipt": "orchestration-validation-readiness-receipt",
  "return_projection": "oos.validation-readiness-run.v1",
  "evidence_and_retention": {
    "aggregate_events_retained": true,
    "raw_validator_output_in_temporal_payload": false,
    "local_paths_in_temporal_payload": false,
    "owner_receipt_refs_only": true
  },
  "security_requirements": {
    "secret_values_in_payload": false,
    "caller_identity_required": true,
    "allowed_caller_ids": [
      "governance-operations-console"
    ],
    "operator_approval_required": true,
    "fresh_activation_review_required": true
  },
  "rollout_and_rollback": {
    "start_disabled_by_default": true,
    "worker_replicas_before_activation": 0,
    "suspension_behavior": "Deny new runs and retain definition and run projections.",
    "rollback_behavior": "Deny new starts, signal the admitted cancel control to every running definition execution, keep workflow polling available until terminal projections and aggregate receipts are verified, then scale the OOS workflow worker to zero."
  }
