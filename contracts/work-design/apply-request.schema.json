{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.workspace.local/oos/work-design/apply-request.v1.schema.json",
  "title": "Delivery Work Design operator apply request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "correlation_id",
    "idempotency_key",
    "delivery_id",
    "package_ref",
    "source_ref",
    "source_revision",
    "operator",
    "acceptance",
    "accepted_draft"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "$ref": "#/$defs/stableId" },
    "correlation_id": { "$ref": "#/$defs/stableId" },
    "idempotency_key": { "$ref": "#/$defs/stableId" },
    "delivery_id": { "type": "string", "pattern": "^delivery-[1-9][0-9]*$" },
    "package_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
    "source_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
    "source_revision": { "type": "string", "minLength": 1, "maxLength": 256 },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "handle": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "accepted_at", "accepted_by"],
      "properties": {
        "decision": { "const": "apply" },
        "accepted_at": { "type": "string", "format": "date-time" },
        "accepted_by": { "$ref": "#/$defs/stableId" },
        "note": { "type": "string", "maxLength": 8000 }
      }
    },
    "accepted_draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft_id", "draft_digest", "tree"],
      "properties": {
        "draft_id": { "$ref": "#/$defs/stableId" },
        "draft_digest": { "$ref": "#/$defs/sha256" },
        "tree": { "$ref": "#/$defs/workDesignNode" }
      }
    },
    "advisor_evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["response_id", "gateway_audit_ref"],
        "properties": {
          "response_id": { "$ref": "#/$defs/stableId" },
          "gateway_audit_ref": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "workDesignNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "description", "draft_body", "remark"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "kind": { "enum": ["Epic", "Feature", "Risk", "User story"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "description": { "type": "string", "maxLength": 8000 },
        "draft_body": { "type": "string", "maxLength": 20000 },
        "remark": { "type": "string", "maxLength": 8000 },
        "children": {
          "type": "array",
          "maxItems": 250,
          "items": { "$ref": "#/$defs/workDesignNode" }
        }
      }
    }
  }
}
