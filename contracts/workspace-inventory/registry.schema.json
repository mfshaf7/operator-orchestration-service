{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operator-orchestration-service.local/contracts/workspace-inventory/registry.schema.json",
  "title": "Workspace Inventory Registry Projection",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_id",
    "projection_id",
    "projection_digest",
    "authority_revision",
    "projected_at",
    "canonical_authority",
    "canonical_mutation",
    "records",
    "eligible_promotions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "workflow_id": { "const": "workspace-inventory-registry" },
    "projection_id": { "type": "string", "pattern": "^workspace-inventory-registry:[0-9a-f]{24}$" },
    "projection_digest": { "$ref": "#/$defs/digest" },
    "authority_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "projected_at": { "type": "string", "format": "date-time" },
    "canonical_authority": {
      "type": "object",
      "required": ["repo", "branch", "intake_path", "inventory_paths"],
      "properties": {
        "repo": { "const": "workspace-governance" },
        "branch": { "const": "main" },
        "intake_path": { "const": "contracts/intake-register.yaml" },
        "inventory_paths": {
          "type": "object",
          "required": ["repo", "product", "component"],
          "properties": {
            "repo": { "const": "contracts/repos.yaml" },
            "product": { "const": "contracts/products.yaml" },
            "component": { "const": "contracts/components.yaml" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "canonical_mutation": { "const": false },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    },
    "eligible_promotions": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "kind": { "enum": ["repo", "product", "component"] },
    "target": {
      "type": "object",
      "required": ["kind", "name", "record_id"],
      "properties": {
        "kind": { "$ref": "#/$defs/kind" },
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "record_id": { "type": "string", "pattern": "^(repo|product|component):[a-z0-9][a-z0-9._-]*$" }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": ["id", "kind", "name", "version", "posture", "maturity", "owner_refs", "lineage", "last_mutation", "record_digest"],
      "properties": {
        "id": { "type": "string", "pattern": "^(repo|product|component):[a-z0-9][a-z0-9._-]*$" },
        "kind": { "$ref": "#/$defs/kind" },
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "version": { "type": "integer", "minimum": 1 },
        "posture": { "enum": ["active", "suspended", "retired"] },
        "maturity": { "oneOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
        "owner_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "lineage": {
          "type": "object",
          "required": ["source", "source_ref", "source_digest", "intake_entry_version"],
          "properties": {
            "source": { "$ref": "#/$defs/text" },
            "source_ref": { "$ref": "#/$defs/text" },
            "source_digest": { "$ref": "#/$defs/digest" },
            "intake_entry_version": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] }
          },
          "additionalProperties": false
        },
        "last_mutation": {
          "type": "object",
          "required": ["id", "action", "applied_at", "request_ref", "readiness_ref"],
          "properties": {
            "id": { "$ref": "#/$defs/text" },
            "action": { "$ref": "#/$defs/text" },
            "applied_at": { "type": "string", "format": "date-time" },
            "request_ref": { "oneOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
            "readiness_ref": { "oneOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] }
          },
          "additionalProperties": false
        },
        "record_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["target", "intake_entry_ref", "active_record", "owner_refs", "approval_refs", "candidate_digest"],
      "properties": {
        "target": { "$ref": "#/$defs/target" },
        "intake_entry_ref": {
          "type": "object",
          "required": ["id", "version", "digest"],
          "properties": {
            "id": { "type": "string", "pattern": "^(repo|product|component):[a-z0-9][a-z0-9._-]*$" },
            "version": { "type": "integer", "minimum": 1 },
            "digest": { "$ref": "#/$defs/digest" }
          },
          "additionalProperties": false
        },
        "active_record": {
          "type": "object",
          "required": ["kind", "id", "value"],
          "properties": {
            "kind": { "$ref": "#/$defs/kind" },
            "id": { "type": "string", "pattern": "^(repo|product|component):[a-z0-9][a-z0-9._-]*$" },
            "value": { "type": "object", "minProperties": 1 }
          },
          "additionalProperties": false
        },
        "owner_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "approval_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "candidate_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  }
}
