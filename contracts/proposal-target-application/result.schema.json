{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposal To Prototype Target Application Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "application_ref", "replayed", "readback", "receipt", "result_digest"],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_type": { "const": "proposal-prototype-application-result" },
    "application_ref": { "$ref": "#/$defs/ref" },
    "replayed": { "type": "boolean" },
    "readback": {
      "type": "object", "additionalProperties": false,
      "required": ["target_record_ref", "authority_state", "source_branch", "source_revision", "registry_digest", "record_digest", "record", "observed_at"],
      "properties": {
        "target_record_ref": { "type": "string", "pattern": "^record://prototype-captures/[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "authority_state": { "const": "review-branch" },
        "source_branch": { "type": "string", "minLength": 1, "not": { "enum": ["main", "master"] } },
        "source_revision": { "type": "string", "pattern": "^git-tree:[0-9a-f]{40}$" },
        "registry_digest": { "$ref": "#/$defs/digest" },
        "record_digest": { "$ref": "#/$defs/digest" },
        "record": { "type": "object" },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt_ref", "owner", "source_record_ref", "source_record_version", "source_packet_ref", "target_record_ref", "prototype_id", "outcome", "recorded_at", "next_action", "correlation_id", "idempotency_key"],
      "properties": {
        "receipt_ref": { "type": "string", "pattern": "^proposal-prototype-target-receipt:[a-z0-9][a-z0-9._-]*:[0-9a-f]{64}$" },
        "owner": { "const": "workspace-prototype-studio" },
        "source_record_ref": { "type": "string", "pattern": "^openproject://work_packages/[1-9][0-9]*$" },
        "source_record_version": { "type": "string", "pattern": "^version-[1-9][0-9]*$" },
        "source_packet_ref": { "$ref": "#/$defs/text" },
        "target_record_ref": { "type": "string", "pattern": "^record://prototype-captures/[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "prototype_id": { "type": "string", "pattern": "^prototype:[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "outcome": { "enum": ["prepared", "replayed"] },
        "recorded_at": { "type": "string", "format": "date-time" },
        "next_action": {
          "type": "object", "additionalProperties": false, "required": ["code", "owner_ref"],
          "properties": { "code": { "const": "prototype-landing" }, "owner_ref": { "const": "operator-orchestration-service" } }
        },
        "correlation_id": { "$ref": "#/$defs/text" },
        "idempotency_key": { "$ref": "#/$defs/text" }
      }
    },
    "result_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["id", "digest"],
      "properties": { "id": { "$ref": "#/$defs/text" }, "digest": { "$ref": "#/$defs/digest" } }
    }
  }
}
