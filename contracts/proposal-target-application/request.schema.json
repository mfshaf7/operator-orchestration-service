{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public-Safe Proposal To Prototype Target Application Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "application_id", "requested_at",
    "source", "authorization", "target", "source_branch", "request_digest"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "artifact_type": { "const": "proposal-prototype-application" },
    "application_id": { "type": "string", "pattern": "^proposal-prototype-application:proposal-[1-9][0-9]*:[1-9][0-9]*$" },
    "requested_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority", "proposal_id", "record_ref", "record_version",
        "projection_state", "status", "handoff_packet_ref",
        "handoff_packet_digest", "route"
      ],
      "properties": {
        "authority": { "const": "workspace-proposals" },
        "proposal_id": { "type": "string", "pattern": "^idea-[1-9][0-9]*$" },
        "record_ref": { "type": "string", "pattern": "^openproject://work_packages/[1-9][0-9]*$" },
        "record_version": { "type": "string", "pattern": "^version-[1-9][0-9]*$" },
        "projection_state": { "const": "current" },
        "status": { "const": "accepted" },
        "handoff_packet_ref": { "type": "string", "pattern": "^(proposal-packet:[1-9][0-9]*|proposal-handoff:idea-[1-9][0-9]*:version-[1-9][0-9]*)$" },
        "handoff_packet_digest": { "$ref": "#/$defs/digest" },
        "route": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "source_custody"],
          "properties": {
            "target": { "const": "prototype" },
            "source_custody": { "$ref": "#/$defs/sourceCustody" }
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "decision", "receipt_ref"],
      "properties": {
        "authority": { "const": "operator-orchestration-service" },
        "decision": { "const": "approved" },
        "receipt_ref": { "type": "string", "pattern": "^oos://proposal-target-authorizations/[0-9a-f]{64}$" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prototype_id", "expected_state"],
      "properties": {
        "prototype_id": { "type": "string", "pattern": "^prototype:proposal-[1-9][0-9]*$" },
        "expected_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_revision", "registry_digest", "record_present", "record_digest"],
          "properties": {
            "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "registry_digest": { "$ref": "#/$defs/digest" },
            "record_present": { "const": false },
            "record_digest": { "type": "null" }
          }
        }
      }
    },
    "source_branch": { "type": "string", "pattern": "^proposal-target/[0-9a-f]{64}$" },
    "request_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sourceCustody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "repository_mode", "repository_gate_state"],
      "properties": {
        "classification": { "enum": ["existing-repo", "new-repo-required", "platform-internal", "non-source-work"] },
        "repository_mode": { "enum": ["existing", "new", "not-required"] },
        "repository_gate_state": { "const": "resolved" }
      }
    }
  }
}
