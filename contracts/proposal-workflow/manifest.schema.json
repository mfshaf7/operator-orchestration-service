{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace-governance.local/oos/proposal-workflow/manifest.schema.json",
  "title": "OOS Proposal Workflow Contract Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "canonical_authority",
    "mutation_adapter",
    "lifecycle_states",
    "source_guards",
    "capabilities",
    "transitions",
    "handoff_completion"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_id": {
      "const": "oos.proposal-workflow.v1"
    },
    "canonical_authority": {
      "const": "openproject://projects/workspace-proposals"
    },
    "mutation_adapter": {
      "const": "operator-orchestration-service"
    },
    "lifecycle_states": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/lifecycle_status"
      }
    },
    "source_guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_version_required",
        "current_projection_required",
        "direct_authority_bypass_allowed"
      ],
      "properties": {
        "record_version_required": {
          "const": true
        },
        "current_projection_required": {
          "const": true
        },
        "direct_authority_bypass_allowed": {
          "const": false
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live",
        "contract_admitted",
        "deferred"
      ],
      "properties": {
        "live": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/live_capability"
          }
        },
        "contract_admitted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/admitted_capability"
          }
        },
        "deferred": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deferred_capability"
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "handoff_completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preparation_changes_lifecycle",
        "application_requires_target_receipt",
        "application_changes_lifecycle",
        "implementation_requires_downstream_completion"
      ],
      "properties": {
        "preparation_changes_lifecycle": {
          "const": false
        },
        "application_requires_target_receipt": {
          "const": true
        },
        "application_changes_lifecycle": {
          "const": false
        },
        "implementation_requires_downstream_completion": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,255}$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "captured",
        "triaged",
        "parked",
        "accepted",
        "rejected",
        "implemented"
      ]
    },
    "live_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "method",
        "path"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/v1/(ideas|proposals)"
        }
      }
    },
    "admitted_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema_ref",
        "runtime_status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "schema_ref": {
          "type": "string",
          "pattern": "^contracts/proposal-workflow/[a-z-]+\\.schema\\.json$"
        },
        "runtime_status": {
          "const": "not-implemented"
        }
      }
    },
    "deferred_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reason"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "from",
        "to",
        "runtime_status"
      ],
      "properties": {
        "command": {
          "$ref": "#/$defs/identifier"
        },
        "from": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lifecycle_status"
          }
        },
        "to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lifecycle_status"
          }
        },
        "runtime_status": {
          "enum": [
            "live",
            "contract-admitted"
          ]
        }
      }
    }
  }
}
