{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace-governance.local/oos/proposal-workflow/event.schema.json",
  "title": "OOS Proposal Workflow Event V1",
  "description": "Immutable Proposal workflow event projection for operator history and reconciliation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "proposal_id",
    "record_version",
    "event_type",
    "status_before",
    "status_after",
    "actor",
    "command_id",
    "receipt_refs",
    "summary",
    "occurred_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "$ref": "#/$defs/identifier"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^idea-[1-9][0-9]*$"
    },
    "record_version": {
      "$ref": "#/$defs/identifier"
    },
    "event_type": {
      "enum": [
        "captured",
        "triaged",
        "disposition-recorded",
        "handoff-blocked",
        "handoff-prepared",
        "handoff-applied",
        "target-application-failed",
        "implementation-reconciled"
      ]
    },
    "status_before": {
      "oneOf": [
        {
          "$ref": "#/$defs/lifecycle_status"
        },
        {
          "type": "null"
        }
      ]
    },
    "status_after": {
      "$ref": "#/$defs/lifecycle_status"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "operator",
            "system",
            "target"
          ]
        },
        "id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "command_id": {
      "$ref": "#/$defs/nullable_identifier"
    },
    "receipt_refs": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,255}$"
    },
    "nullable_identifier": {
      "oneOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "captured",
        "triaged",
        "parked",
        "accepted",
        "rejected",
        "implemented"
      ]
    }
  }
}
