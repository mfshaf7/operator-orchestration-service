{
  "schema_version": 1,
  "contract_id": "oos.proposal-workflow.v1",
  "canonical_authority": "openproject://projects/workspace-proposals",
  "mutation_adapter": "operator-orchestration-service",
  "lifecycle_states": [
    "captured",
    "triaged",
    "parked",
    "accepted",
    "rejected",
    "implemented"
  ],
  "source_guards": {
    "record_version_required": true,
    "current_projection_required": true,
    "direct_authority_bypass_allowed": false
  },
  "capabilities": {
    "live": [
      {
        "id": "proposal-list",
        "method": "GET",
        "path": "/v1/ideas"
      },
      {
        "id": "proposal-capture",
        "method": "POST",
        "path": "/v1/ideas/capture"
      },
      {
        "id": "proposal-source-lookup",
        "method": "POST",
        "path": "/v1/ideas/lookup"
      },
      {
        "id": "proposal-read",
        "method": "GET",
        "path": "/v1/ideas/{idea_id}"
      },
      {
        "id": "proposal-triage",
        "method": "POST",
        "path": "/v1/ideas/{idea_id}/triage"
      },
      {
        "id": "proposal-decision",
        "method": "POST",
        "path": "/v1/ideas/{idea_id}/decision"
      },
      {
        "id": "proposal-evaluation",
        "method": "POST",
        "path": "/v1/ideas/{idea_id}/evaluation"
      },
      {
        "id": "proposal-delivery-consume",
        "method": "POST",
        "path": "/v1/ideas/{idea_id}/consume"
      },
      {
        "id": "proposal-delivery-closeout",
        "method": "POST",
        "path": "/v1/ideas/{idea_id}/closeout"
      },
      {
        "id": "proposal-versioned-command",
        "method": "POST",
        "path": "/v1/proposals/{proposal_id}/commands"
      },
      {
        "id": "proposal-versioned-projection",
        "method": "GET",
        "path": "/v1/proposals/{proposal_id}/projection"
      },
      {
        "id": "proposal-delivery-application",
        "method": "POST",
        "path": "/v1/proposals/{proposal_id}/handoff/apply"
      },
      {
        "id": "proposal-event-projection",
        "method": "GET",
        "path": "/v1/proposals/{proposal_id}/events/{event_id}"
      },
      {
        "id": "proposal-history-projection",
        "method": "GET",
        "path": "/v1/proposals/{proposal_id}/history"
      }
    ],
    "contract_admitted": [],
    "deferred": [
      {
        "id": "proposal-console-adapter",
        "reason": "Console live wiring is a separate downstream landing unit after this OOS contract merges."
      },
      {
        "id": "proposal-realtime-push",
        "reason": "Polling and explicit refresh remain the first live projection transport; push transport requires separate admission."
      },
      {
        "id": "proposal-prototype-application",
        "reason": "Prototype application remains a separate target-owned contract and receipt boundary."
      },
      {
        "id": "proposal-repository-creation",
        "reason": "Repository creation remains owned by Repository Operation and is only a Proposal handoff gate."
      },
      {
        "id": "proposal-ai-assist",
        "reason": "Advisor output remains draft-only until governed AI activation is separately approved."
      }
    ]
  },
  "transitions": [
    {
      "command": "triage",
      "from": [
        "captured",
        "triaged"
      ],
      "to": [
        "triaged"
      ],
      "runtime_status": "live"
    },
    {
      "command": "disposition",
      "from": [
        "triaged",
        "parked",
        "accepted",
        "rejected"
      ],
      "to": [
        "parked",
        "accepted",
        "rejected"
      ],
      "runtime_status": "live"
    },
    {
      "command": "handoff",
      "from": [
        "accepted"
      ],
      "to": [
        "accepted"
      ],
      "runtime_status": "live"
    },
    {
      "command": "delivery-closeout",
      "from": [
        "accepted"
      ],
      "to": [
        "implemented"
      ],
      "runtime_status": "live"
    }
  ],
  "handoff_completion": {
    "preparation_changes_lifecycle": false,
    "application_requires_target_receipt": true,
    "application_changes_lifecycle": false,
    "implementation_requires_downstream_completion": true
  }
}
