{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace-governance.local/oos/proposal-workflow/history.schema.json",
  "title": "OOS Proposal Workflow History V1",
  "description": "Read-only, cursor-bounded Proposal history projection. History never advances workflow state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "record_version",
    "events",
    "next_cursor"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^idea-[1-9][0-9]*$"
    },
    "record_version": {
      "$ref": "#/$defs/identifier"
    },
    "events": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "event.schema.json"
      }
    },
    "next_cursor": {
      "$ref": "#/$defs/nullable_identifier"
    }
  },
  "example": {
    "schema_version": 1,
    "proposal_id": "idea-851",
    "record_version": "version-18",
    "events": [
      {
        "schema_version": 1,
        "event_id": "proposal-event:851:triage-1",
        "proposal_id": "idea-851",
        "record_version": "version-18",
        "event_type": "triaged",
        "status_before": "captured",
        "status_after": "triaged",
        "actor": {
          "kind": "operator",
          "id": "operator:workspace-owner"
        },
        "command_id": "proposal-command:851:triage-1",
        "receipt_refs": [
          "proposal-receipt:851:triage-1"
        ],
        "summary": "The Proposal is ready for a bounded disposition decision.",
        "occurred_at": "2026-08-16T03:10:00Z"
      }
    ],
    "next_cursor": null
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,255}$"
    },
    "nullable_identifier": {
      "oneOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "captured",
        "triaged",
        "parked",
        "accepted",
        "rejected",
        "implemented"
      ]
    }
  }
}
