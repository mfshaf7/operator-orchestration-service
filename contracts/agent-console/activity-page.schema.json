{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.operator-orchestration-service.local/agent-console/activity-page.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "caller_id",
    "operator_id",
    "observed_at",
    "items",
    "next_cursor",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_type": {
      "const": "ai-activity-page"
    },
    "caller_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "operator_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "session_ref",
          "invocation_id",
          "kind",
          "subject_ref",
          "state",
          "requested_at",
          "completed_at",
          "receipt_ref",
          "audit_ref",
          "context_ref",
          "error_code"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "source": {
            "enum": [
              "agent-console",
              "work-design",
              "refinement"
            ]
          },
          "session_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 1024
          },
          "invocation_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": [
              null,
              "assistant-response",
              "proposal-triage",
              "proposal-disposition",
              "prototype-candidate",
              "prototype-baseline",
              "work-design-context",
              "work-design-tree",
              "refinement-metadata",
              "execution-tree",
              "work-design-blocker",
              "refinement-blocker",
              "definition-design"
            ]
          },
          "subject_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 1024
          },
          "state": {
            "enum": [
              "working",
              "completed",
              "failed",
              "cancelled",
              "interrupted"
            ]
          },
          "requested_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "receipt_ref": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "uri",
                  "digest"
                ],
                "properties": {
                  "uri": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            ]
          },
          "audit_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 1024
          },
          "context_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 1024
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "coverage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
