{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operator-orchestration-service.local/contracts/delivery-change/error.schema.json",
  "title": "Delivery in-flight change error",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "code", "message", "retryable", "next_action"],
  "properties": {
    "schema_version": { "const": 1 },
    "code": { "type": "string" },
    "message": { "type": "string" },
    "retryable": { "type": "boolean" },
    "details": {},
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "label", "authority"],
      "properties": {
        "code": { "type": "string" },
        "label": { "type": "string" },
        "authority": { "type": "string" }
      }
    }
  }
}
