{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operator-orchestration-service.local/contracts/refinement/packet.schema.json",
  "title": "Delivery Refinement packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "packet_revision",
    "status",
    "active_step",
    "source",
    "target_tree",
    "draft_groups",
    "readiness_gates",
    "apply_plan",
    "last_saved_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "packet_id": { "$ref": "#/$defs/id" },
    "packet_revision": { "$ref": "#/$defs/nonEmptyString" },
    "status": { "enum": ["drafting", "ready_for_review", "blocked", "stale", "applied"] },
    "active_step": { "enum": ["metadata_draft", "readiness_review", "apply_refinement"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery_id",
        "package_ref",
        "source_ref",
        "source_revision",
        "source_work_design_receipt_id",
        "tree_snapshot_ref",
        "finalized_brief_ref"
      ],
      "properties": {
        "delivery_id": { "type": "string", "pattern": "^delivery-[1-9][0-9]*$" },
        "package_ref": { "$ref": "#/$defs/nonEmptyString" },
        "source_ref": { "$ref": "#/$defs/nonEmptyString" },
        "source_revision": { "$ref": "#/$defs/nonEmptyString" },
        "source_work_design_receipt_id": { "$ref": "#/$defs/nonEmptyString" },
        "tree_snapshot_ref": { "$ref": "#/$defs/nonEmptyString" },
        "finalized_brief_ref": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "target_tree": { "$ref": "#/$defs/treeNode" },
    "draft_groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/draftGroup" }
    },
    "readiness_gates": {
      "type": "array",
      "items": { "$ref": "#/$defs/readinessGate" }
    },
    "apply_plan": { "$ref": "#/$defs/applyPlan" },
    "last_saved_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "treeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "description", "draft_body", "remark", "children"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["Epic", "Feature", "User story", "Defect", "Task", "Risk", "Milestone", "PI Objective"] },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "type": "string" },
        "draft_body": { "type": "string" },
        "remark": { "type": "string" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/treeNode" } }
      }
    },
    "routeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_kind", "oos_route", "payload_key", "target"],
      "properties": {
        "operation_kind": { "$ref": "#/$defs/operationKind" },
        "oos_route": { "$ref": "#/$defs/nonEmptyString" },
        "payload_key": { "$ref": "#/$defs/nonEmptyString" },
        "target": { "enum": ["initiative", "child_plan", "work_item"] }
      }
    },
    "draftField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_key",
        "backend_field",
        "label",
        "field_kind",
        "required",
        "status",
        "value",
        "validation_hint",
        "route_binding"
      ],
      "properties": {
        "field_key": { "$ref": "#/$defs/id" },
        "backend_field": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "field_kind": { "enum": ["generated", "long_text", "number", "select", "short_text"] },
        "required": { "type": "boolean" },
        "status": { "enum": ["blocked", "complete", "dirty", "missing", "stale"] },
        "value": { "type": "string" },
        "allowed_values": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "target_kinds": { "type": "array", "uniqueItems": true, "items": { "enum": ["Epic", "Feature", "User story", "Defect", "Task", "Risk", "Milestone"] } },
        "target_node_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "target_values": { "type": "object", "additionalProperties": { "type": "string" } },
        "target_statuses": { "type": "object", "additionalProperties": { "enum": ["blocked", "complete", "dirty", "missing", "stale"] } },
        "validation_hint": { "$ref": "#/$defs/nonEmptyString" },
        "value_limit": { "type": "integer", "minimum": 1 },
        "route_binding": { "$ref": "#/$defs/routeBinding" }
      }
    },
    "draftGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "title", "summary", "fields"],
      "properties": {
        "group_id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/draftField" } }
      }
    },
    "readinessGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "label", "detail", "status"],
      "properties": {
        "gate_id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "detail": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "enum": ["blocked", "open", "passed", "warning"] },
        "oos_route": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "operationKind": {
      "enum": ["bulk_update", "governance", "plan_apply", "plan_repair", "work_item_create", "work_item_update"]
    },
    "applyOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "kind", "label", "detail", "target", "oos_route", "status"],
      "properties": {
        "operation_id": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/operationKind" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "detail": { "$ref": "#/$defs/nonEmptyString" },
        "target": { "$ref": "#/$defs/nonEmptyString" },
        "oos_route": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "enum": ["planned", "skipped"] }
      }
    },
    "applyPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "expected_routes", "operations"],
      "properties": {
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "expected_routes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/applyOperation" } }
      }
    }
  }
}
